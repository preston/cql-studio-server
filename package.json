{
  "name": "cql-studio-server",
  "version": "2.1.1",
  "description": "CQL Studio backend services and MCP tool orchestration, provided as an Express server using ESM modules",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "watch": "tsx watch src/server.ts",
    "clean": "rm -rf dist",
    "test": "node --test --import tsx tests/ollama-proxy.test.ts tests/vsac-proxy.test.ts"
  },
  "author": "Preston Lee",
  "license": "Apache-2.0",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "node-fetch": "^3.3.2",
    "rss-parser": "^3.13.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
